# Canonical site URL used for metadata, Open Graph, sitemap and JSON-LD.
# Leave unset on Vercel to use the project's production URL (thefolkweddings.vercel.app).
# Use https://thefolkweddings.in only once that domain is registered and pointed at Vercel.
# NEXT_PUBLIC_SITE_URL=https://thefolkweddings.in

# Overrides the studio WhatsApp number in src/content/site.ts (digits with country code, no "+").
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# true keeps the demo out of search indexes (noindex, nofollow). Set to false at launch.
NEXT_PUBLIC_DEMO_MODE=true

# Optional. Photograph for the link preview card, relative to the project root.
# OG_IMAGE_SOURCE=images/hero-desktop.webp
